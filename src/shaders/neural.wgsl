// Requires the NN_* constants generated by architectureToWgsl() in rockModels.ts.
// 依赖 rockModels.ts 中 architectureToWgsl() 生成的 NN_* 常量。

// All species back to back. Within a model, each layer is row-major weights
// [out][in] followed by its bias (see training/neural_sdf/export.py).
// 所有种类的权重首尾相连。每个模型里，每层先存按行排列的权重 [out][in]，再存偏置。
@group(0) @binding(2) var<storage, read> rockWeights: array<f32>;

const TWO_PI: f32 = 6.2831853;

// [x, sin(2^k x), cos(2^k x)] for k = 0..NN_FREQUENCIES-1, matching model.py.
// Angles are range-reduced to [0, 2pi) first: GPU sin/cos are often approximate for
// large arguments, and per-octave evaluation keeps errors from compounding.
// 先把角度归约到 [0, 2pi)：很多 GPU 的 sin/cos 在大参数下精度较差；
// 每个频率单独计算，避免误差逐级放大。
fn positionalEncoding(x: vec3f) -> array<f32, NN_INPUT_DIM> {
  var features: array<f32, NN_INPUT_DIM>;
  features[0] = x.x;
  features[1] = x.y;
  features[2] = x.z;
  var frequency = 1.0;
  for (var k = 0u; k < NN_FREQUENCIES; k++) {
    let angle = fract(frequency * x / TWO_PI) * TWO_PI;
    let s = sin(angle);
    let c = cos(angle);
    let base = 3u + 6u * k;
    features[base] = s.x;
    features[base + 1u] = s.y;
    features[base + 2u] = s.z;
    features[base + 3u] = c.x;
    features[base + 4u] = c.y;
    features[base + 5u] = c.z;
    frequency *= 2.0;
  }
  return features;
}

fn activate(v: f32) -> f32 {
  if (NN_ACTIVATION_SILU) {
    return v / (1.0 + exp(-v));
  }
  return max(v, 0.0);
}

// Baseline evaluator: scalar loops reading weights from a storage buffer.
// 基线版本：标量循环，直接从 storage buffer 读取权重。
fn rockNeuralSdf(x: vec3f, species: u32) -> f32 {
  var input = positionalEncoding(x);
  var offset = species * NN_FLOATS_PER_MODEL;

  var hidden: array<f32, NN_HIDDEN_WIDTH>;
  let firstBias = offset + NN_HIDDEN_WIDTH * NN_INPUT_DIM;
  for (var o = 0u; o < NN_HIDDEN_WIDTH; o++) {
    let row = offset + o * NN_INPUT_DIM;
    var sum = rockWeights[firstBias + o];
    for (var i = 0u; i < NN_INPUT_DIM; i++) {
      sum += rockWeights[row + i] * input[i];
    }
    hidden[o] = activate(sum);
  }
  offset = firstBias + NN_HIDDEN_WIDTH;

  for (var layer = 1u; layer < NN_HIDDEN_LAYERS; layer++) {
    var next: array<f32, NN_HIDDEN_WIDTH>;
    let bias = offset + NN_HIDDEN_WIDTH * NN_HIDDEN_WIDTH;
    for (var o = 0u; o < NN_HIDDEN_WIDTH; o++) {
      let row = offset + o * NN_HIDDEN_WIDTH;
      var sum = rockWeights[bias + o];
      for (var i = 0u; i < NN_HIDDEN_WIDTH; i++) {
        sum += rockWeights[row + i] * hidden[i];
      }
      next[o] = activate(sum);
    }
    hidden = next;
    offset = bias + NN_HIDDEN_WIDTH;
  }

  var result = rockWeights[offset + NN_HIDDEN_WIDTH];
  for (var i = 0u; i < NN_HIDDEN_WIDTH; i++) {
    result += rockWeights[offset + i] * hidden[i];
  }
  return result;
}
